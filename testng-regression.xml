<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Regression Suite" verbose="1" parallel="classes" thread-count="3">
    <test name="Full Regression">
        <groups>
            <run>
                <include name="sanity"/>
                <include name="functional"/>
                <include name="negative"/>
                <include name="regression"/>
            </run>
        </groups>
        <classes>
            <class name="com.nikhil.qa.tests.SanityTests"/>
            <class name="com.nikhil.qa.tests.FunctionalTests"/>
            <class name="com.nikhil.qa.tests.NegativeTests"/>
        </classes>
    </test>
</suite>
